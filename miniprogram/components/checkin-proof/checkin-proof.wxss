.proof-mask { position:fixed; top:0; right:0; bottom:0; left:0; background:rgba(0,0,0,.45); z-index:2000; display:flex; align-items:center; justify-content:center; }
.proof-dialog { width:86%; max-height:85vh; overflow-y:auto; box-sizing:border-box; background:#fff; border-radius:24rpx; padding:32rpx; }
.title { font-size:34rpx; font-weight:600; color:#333; }
.task-name { margin:20rpx 0; font-size:28rpx; color:#666; }
.proof-image { width:100%; height:300rpx; margin-bottom:20rpx; }
.proof-input { background:#F6F8FC; padding:20rpx; border-radius:12rpx; font-size:28rpx; margin:24rpx 0; }
.actions { display:flex; gap:20rpx; }
.actions button { flex:1; font-size:28rpx; }
