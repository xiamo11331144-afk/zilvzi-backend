/* AI 助手悬浮球 */

.ai-ball {
  position: fixed;
  z-index: 9999;
  width: 110rpx;
  height: 110rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.ai-ball.dragging {
  opacity: 0.8;
  transform: scale(1.1);
}

.ai-ball.open {
  transform: scale(0);
  opacity: 0;
}

.ball-inner {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.4);
  position: relative;
  z-index: 2;
}

.ball-icon {
  font-size: 48rpx;
}

.ball-pulse {
  position: absolute;
  top: 0;
  left: 0;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(74, 144, 217, 0.3);
  animation: pulse 2s ease-out infinite;
  z-index: 1;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

.ball-label {
  position: absolute;
  top: -8rpx;
  right: -20rpx;
  background: #FF6B6B;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  z-index: 3;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

/* AI 聊天面板 */
.ai-panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9998;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.ai-panel.show {
  opacity: 1;
  visibility: visible;
}

.panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
}

.panel-content {
  position: relative;
  width: 100%;
  height: 75vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  z-index: 1;
}

.ai-panel.show .panel-content {
  transform: translateY(0);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  border-radius: 32rpx 32rpx 0 0;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.panel-close {
  font-size: 36rpx;
  color: #fff;
  padding: 10rpx;
}

.panel-body {
  flex: 1;
  overflow: hidden;
}

.chat-messages {
  height: 100%;
  padding: 20rpx;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.message-item.user {
  justify-content: flex-end;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.message-avatar.user-avatar {
  background: #52C41A;
  font-size: 24rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  margin: 0 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.message-item.ai .message-bubble {
  background: #f5f5f5;
  color: #333;
}

.message-item.user .message-bubble {
  background: #4A90D9;
  color: #fff;
}

.typing-indicator {
  display: flex;
  padding: 20rpx 28rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  width: fit-content;
  margin-left: 80rpx;
}

.typing-indicator .dot {
  width: 12rpx;
  height: 12rpx;
  background: #999;
  border-radius: 50%;
  margin: 0 4rpx;
  animation: typing 1.4s infinite;
}

.typing-indicator .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-indicator .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

/* 快捷问题 */
.quick-questions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fafafa;
}

.quick-item {
  padding: 10rpx 20rpx;
  background: #e8f4ff;
  color: #4A90D9;
  border-radius: 24rpx;
  font-size: 24rpx;
  border: 1rpx solid #d0e8ff;
}

/* 底部输入框 */
.panel-footer {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.chat-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.send-btn {
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  color: #fff;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}