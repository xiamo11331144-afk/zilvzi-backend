/* pages/message/message.wxss */
.page-message { min-height:100vh; background:#F6F8FC; }
.conversation-list { padding:16rpx; }
.conv-item { display:flex; align-items:center; padding:24rpx; background:#fff; border-radius:16rpx; margin-bottom:12rpx; }
.conv-item .avatar { width:80rpx; height:80rpx; border-radius:50%; margin-right:16rpx; }
.conv-info { flex:1; min-width:0; }
.conv-name { font-size:30rpx; font-weight:600; display:block; }
.conv-last { font-size:24rpx; color:#999; display:block; margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.conv-time { text-align:right; }
.conv-time text { font-size:22rpx; color:#B8BCC8; display:block; }
.unread-dot { min-width:32rpx; height:32rpx; border-radius:16rpx; background:#FF4D4F; display:inline-flex; align-items:center; justify-content:center; padding:0 8rpx; margin-top:8rpx; }
.unread-num { font-size:18rpx; color:#fff; line-height:1; }
.chat-header { display:flex; align-items:center; padding:20rpx 24rpx; background:#fff; border-bottom:1rpx solid #f0f0f0; }
.back-btn { font-size:36rpx; color:#4A90D9; margin-right:20rpx; }
.chat-name { font-size:34rpx; font-weight:600; }
.chat-messages { height:calc(100vh - 200rpx); padding:20rpx; padding-bottom:140rpx; box-sizing:border-box; }
.chat-item { display:flex; margin-bottom:24rpx; align-items:flex-start; }
.chat-item.me { flex-direction:row-reverse; margin-right:20rpx; }
.chat-avatar { width:64rpx; height:64rpx; border-radius:50%; }
.chat-item.partner .chat-avatar { margin-right:16rpx; }
.chat-item.me .chat-avatar { margin-left:16rpx; }
.chat-bubble { max-width:65%; padding:16rpx 24rpx; border-radius:20rpx; font-size:28rpx; }
.chat-item.partner .chat-bubble { background:#fff; color:#333; }
.chat-item.me .chat-bubble { background:linear-gradient(135deg,#4A90D9,#6DB3F8); color:#fff; }
.chat-input-bar { display:flex; align-items:center; padding:16rpx 24rpx; background:#fff; border-top:1rpx solid #f0f0f0; position:fixed; bottom:0; width:100%; box-sizing:border-box; }
.chat-input { flex:1; background:#F6F8FC; border-radius:40rpx; padding:16rpx 24rpx; font-size:28rpx; margin-right:16rpx; }
.send-btn { background:#4A90D9; color:#fff; border-radius:40rpx; padding:0 32rpx; height:72rpx; line-height:72rpx; font-size:28rpx; border:none; }
.send-btn::after { border:none; }
.empty-state { text-align:center; padding:60rpx; color:#B8BCC8; font-size:28rpx; }
.msg-time { display:block; font-size:20rpx; color:rgba(0,0,0,0.35); margin-top:6rpx; }
.chat-item.me .msg-time { color:rgba(255,255,255,0.65); }

/* 打卡凭证卡片 */
.proof-card { background:#FFFBE6; border-radius:16rpx; padding:16rpx; border:1rpx solid #FFE58F; }
.proof-header { font-size:26rpx; font-weight:600; color:#FA8C16; margin-bottom:12rpx; }
.proof-img { width:100%; border-radius:12rpx; margin-bottom:12rpx; }
.proof-text { font-size:26rpx; color:#333; display:block; margin-bottom:12rpx; line-height:1.5; }
.confirm-btn { background:#52C41A; color:#fff; border:none; border-radius:12rpx; font-size:28rpx; height:72rpx; line-height:72rpx; }
.confirm-btn::after { border:none; }
.confirmed-badge { font-size:24rpx; color:#52C41A; font-weight:600; text-align:center; padding:8rpx 0; }