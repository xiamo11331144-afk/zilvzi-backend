/* pages/stats/stats.wxss */
.page-stats {
  padding: 20rpx;
  padding-bottom: 40rpx;
  min-height: 100vh;
  background: #F6F8FC;
}

/* 顶部统计 */
.stats-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  color: #fff;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  display: block;
}

/* 卡片通用 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.08);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #B8BCC8;
}

/* 趋势图 */
.trend-chart {
  padding: 16rpx 0;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-wrapper {
  width: 48rpx;
  height: 200rpx;
  background: #F0F2F5;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 100%;
  min-height: 16rpx;
  background: #D9DCE2;
  border-radius: 24rpx;
  transition: height 0.5s ease;
}

.bar.active {
  background: linear-gradient(180deg, #4A90D9, #6DB3F8);
}

.bar-label {
  font-size: 22rpx;
  color: #B8BCC8;
  margin-top: 12rpx;
  font-weight: 500;
}

/* 目标完成率 */
.completion-rings {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  justify-content: center;
}

.ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-wrapper {
  width: 120rpx;
  height: 120rpx;
  position: relative;
  margin-bottom: 12rpx;
}

.ring-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #F0F2F5;
}

.ring-progress {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ring-inner {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-percent {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.ring-name {
  font-size: 22rpx;
  color: #666;
  max-width: 120rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 排行榜 */
.ranking-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 48rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #B8BCC8;
  text-align: center;
}

.rank-num.top {
  color: #FAAD14;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 16rpx;
  border: 2rpx solid rgba(74, 144, 217, 0.2);
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  color: #1A1A2E;
}

.rank-streak {
  font-size: 22rpx;
  color: #B8BCC8;
  display: block;
  margin-top: 4rpx;
}

.rank-exp {
  font-size: 26rpx;
  color: #FAAD14;
  font-weight: 700;
}

/* 数据导出 */
.export-buttons {
  display: flex;
  gap: 20rpx;
}

.export-buttons button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.export-icon {
  font-size: 32rpx;
}