/* pages/circle/circle.wxss */
.page-circle {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
}

.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

.create-btn {
  padding: 12rpx 24rpx;
  background: #4A90D9;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 热门标签 */
.hot-tags {
  background: #fff;
  padding: 0 20rpx 20rpx;
}

.tags-scroll {
  white-space: nowrap;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.tag-item.active {
  background: #4A90D9;
  color: #fff;
}

.search-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
}

.create-link {
  font-size: 26rpx;
  color: #4A90D9;
  font-weight: 500;
}

/* 圈子列表 */
.circle-list {
  padding: 20rpx;
}

.circle-item {
  margin-bottom: 20rpx;
}

.circle-header {
  display: flex;
  margin-bottom: 16rpx;
}

.circle-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.circle-info {
  flex: 1;
  overflow: hidden;
}

.circle-name {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.circle-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.circle-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.circle-meta text {
  margin-right: 20rpx;
}

.circle-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.circle-tags .tag {
  padding: 6rpx 16rpx;
  background: #f0f7ff;
  color: #4A90D9;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 我的圈子 */
.my-circles {
  margin: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.my-circles-scroll {
  white-space: nowrap;
}

.my-circle-item {
  display: inline-block;
  margin-right: 24rpx;
  text-align: center;
}

.my-circle-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.my-circle-name {
  font-size: 24rpx;
  color: #333;
  display: block;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mask-close {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  z-index: 1000;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.modal-title { font-size: 32rpx; font-weight: 600; }
.modal-close { font-size: 40rpx; color: #999; }

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
}

.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 26rpx; color: #333; margin-bottom: 10rpx; display: block; }
.form-input { border: 1rpx solid #eee; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 30rpx; width: 100%; box-sizing: border-box; height: 88rpx; }
.form-textarea { border: 1rpx solid #eee; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; width: 100%; height: 160rpx; box-sizing: border-box; }

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 30rpx 30rpx;
  flex-shrink: 0;
}

.modal-footer button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
}

.form-textarea {
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
}

/* 封面上传 */
.cover-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx dashed #ddd;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
}

.upload-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.form-textarea {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  height: 150rpx;
  width: 100%;
}

.tag-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-selector .tag-item {
  padding: 12rpx 24rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.tag-selector .tag-item.active {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
}

.modal-footer button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}