/* pages/ai/ai.wxss */
.page-ai {
  padding-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 建议卡片 */
.suggestions-section {
  padding: 20rpx;
}

.suggestion-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.suggestion-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.suggestion-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.suggestion-icon text {
  font-size: 28rpx;
  color: #fff;
}

.suggestion-title {
  flex: 1;
}

.suggestion-title .title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
}

.suggestion-title .time {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.suggestion-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.suggestion-actions {
  display: flex;
  gap: 20rpx;
}

.suggestion-actions button {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* 智能对话 */
.chat-section {
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
}

.chat-section .flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.clear-btn:active {
  color: #FF4D4F;
}

.chat-messages {
  height: 400rpx;
  padding: 20rpx 0;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.message-item.user {
  justify-content: flex-end;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.message-item.user .message-avatar {
  background: #52C41A;
}

.message-bubble {
  max-width: 70%;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  margin: 0 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.message-item.ai .message-bubble {
  background: #f5f5f5;
  color: #333;
}

.message-item.user .message-bubble {
  background: #4A90D9;
  color: #fff;
}

.typing-indicator {
  display: flex;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  width: fit-content;
}

.typing-indicator .dot {
  width: 12rpx;
  height: 12rpx;
  background: #999;
  border-radius: 50%;
  margin: 0 4rpx;
  animation: typing 1.4s infinite;
}

.typing-indicator .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-indicator .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.chat-input {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.chat-input input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.send-btn {
  background: #4A90D9;
  color: #fff;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn::after {
  border: none;
}

/* 快捷问题 */
.quick-questions {
  margin: 0 20rpx 20rpx;
}

.question-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.question-item {
  padding: 12rpx 24rpx;
  background: #f0f7ff;
  color: #4A90D9;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 数据预测 */
.prediction-card {
  margin: 0 20rpx;
}

.prediction-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.prediction-item:last-child {
  border-bottom: none;
}

.prediction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.prediction-name {
  font-size: 28rpx;
  font-weight: bold;
}

.prediction-rate {
  font-size: 32rpx;
  font-weight: bold;
}

.prediction-rate.high { color: #52C41A; }
.prediction-rate.medium { color: #FAAD14; }
.prediction-rate.low { color: #FF4D4F; }

.prediction-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.prediction-bar {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.prediction-progress {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}