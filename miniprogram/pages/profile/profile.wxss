/* pages/profile/profile.wxss */
.page-profile {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 用户信息头部 */
.profile-header {
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  padding: 40rpx 30rpx 30rpx;
  color: #fff;
}

.user-card {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.user-id {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
  margin-top: 4rpx;
}

.user-level {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.level-tag {
  background: rgba(255, 255, 255, 0.3);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.level-title {
  font-size: 24rpx;
  opacity: 0.8;
}

.edit-btn {
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 24rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 功能菜单 */
.menu-section {
  padding: 20rpx;
}

.menu-group {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 20rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #FF4D4F;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn::after {
  border: none;
}

/* 登录提示 */
.login-section {
  padding: 60rpx 40rpx;
}

.login-section .btn-primary {
  width: 100%;
}

/* 个人信息弹窗 */
.mentor-card{margin:20rpx 20rpx 0;padding:24rpx;background:#fff;border-radius:16rpx}
.mentor-title{font-size:28rpx;font-weight:600;color:#333}
.mentor-state{display:block;margin:12rpx 0;font-size:28rpx;font-weight:600;color:#777}
.mentor-state.available{color:#28854B}
.mentor-state.ineligible,.mentor-state.full,.mentor-reason{color:#A15D24}
.mentor-hint,.mentor-reason{display:block;font-size:23rpx;line-height:1.7;word-break:break-all}
.mentor-hint{color:#737B86;margin-top:6rpx}
.mentor-setting{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 0 12rpx}
.mentor-setting switch{flex-shrink:0}
.mentor-setting-main{display:flex;flex-direction:column;gap:6rpx;min-width:0}
.mentor-hint.error{color:#C74646}
.mentor-retry{padding:12rpx 0;color:#3578B8;font-size:24rpx}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.info-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
}
.info-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}
.info-modal .info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-modal .info-row:last-of-type {
  border-bottom: none;
}
.info-modal .info-label {
  font-size: 28rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}
.info-modal .info-value {
  font-size: 28rpx;
  color: #333;
}
.info-modal .btn-primary {
  margin-top: 32rpx;
  width: 100%;
}