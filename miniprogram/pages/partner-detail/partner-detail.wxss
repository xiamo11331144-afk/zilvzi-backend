/* pages/partner-detail/partner-detail.wxss */
.page-partner-detail {
  padding: 20rpx;
  min-height: 100vh;
  background: #F6F8FC;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 40vh;
  color: #B8BCC8;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 搭子头部 */
.partner-header {
  padding: 32rpx;
}

.partner-profile {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(74, 144, 217, 0.2);
}

.partner-info {
  flex: 1;
}

.partner-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
  color: #1A1A2E;
}

.partner-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #F0F2F5;
  color: #666;
}

.tag-primary {
  background: rgba(74, 144, 217, 0.1);
  color: #4A90D9;
}

.tag-location {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.partner-bio {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 12rpx;
  line-height: 1.5;
}

.partner-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.partner-actions button {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  padding: 0 16rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.btn-outline {
  background: #fff;
  border: 2rpx solid #4A90D9;
  color: #4A90D9;
  border-radius: 24rpx;
}

.btn-primary {
  background: #4A90D9;
  color: #fff;
  border: none;
  border-radius: 24rpx;
}

.btn-danger {
  color: #FF4D4F !important;
  border-color: #FF4D4F !important;
}

.disabled {
  background: #F0F2F5;
  color: #B8BCC8;
  border: 2rpx solid #E8E8E8;
  border-radius: 24rpx;
}

/* 打卡统计 */
.stats-card {
  padding: 28rpx 32rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A2E;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.stat-box {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #4A90D9;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.rate-bar-wrap {
  margin-top: 12rpx;
}

.rate-bar-bg {
  height: 12rpx;
  background: #F0F2F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.rate-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #52C41A);
  border-radius: 6rpx;
  transition: width 0.3s ease;
  min-width: 4rpx;
}

/* 目标列表 */
.goals-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A2E;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.goal-card {
  padding: 24rpx 28rpx;
}

.goal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.goal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.goal-type {
  font-size: 20rpx;
  background: rgba(74, 144, 217, 0.08);
  color: #4A90D9;
  padding: 4rpx 14rpx;
}

.goal-desc {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.goal-stats {
  display: flex;
  gap: 40rpx;
  margin-top: 8rpx;
}

.goal-stat {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.goal-stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #52C41A;
}

.goal-stat-label {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #B8BCC8;
  font-size: 28rpx;
}