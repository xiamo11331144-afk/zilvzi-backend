/* pages/login/login.wxss */
.page-login {
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90D9 0%, #6DB3F8 50%, #F6F8FC 100%);
  padding: 0 40rpx;
}

.login-header {
  padding: 120rpx 0 60rpx;
  text-align: center;
}

.logo {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 4rpx;
}

.slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  margin: 40rpx 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 6rpx;
  backdrop-filter: blur(10px);
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.mode-tab.active {
  background: #fff;
  color: #4A90D9;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 头像选择 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(74, 144, 217, 0.3);
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.avatar-tip {
  font-size: 26rpx;
  color: #4A90D9;
  font-weight: 500;
}

/* 输入框 */
.input-group {
  margin-bottom: 40rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.input-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F0F2F5;
  padding: 24rpx 20rpx;
}

.input-item:last-child {
  border-bottom: none;
}

.input-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.input-prefix {
  font-size: 30rpx;
  color: #1A1A2E;
  margin-right: 20rpx;
  padding-right: 20rpx;
  border-right: 1rpx solid #E8ECF1;
  font-weight: 600;
}

.input-item input {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A2E;
}

.code-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  color: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
}

.code-btn.disabled {
  background: #E8ECF1;
  color: #B8BCC8;
  box-shadow: none;
}

/* 微信登录 */
.btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  border-radius: 48rpx;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 40rpx;
}

.btn-wechat::after {
  border: none;
}

.wechat-icon {
  display: inline-flex;
  width: 44rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 分割线 */
.divider-text {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.line {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.3);
}

.divider-text text {
  padding: 0 24rpx;
}

/* 登录方式切换 */
.login-tabs {
  display: flex;
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  position: relative;
  font-weight: 500;
}

.tab-item.active {
  color: #fff;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #fff;
  border-radius: 3rpx;
}

/* 按钮 */
.btn-primary {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #4A90D9, #6DB3F8);
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.3);
}

/* 协议 */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  padding-bottom: 40rpx;
  flex-wrap: wrap;
}

.agreement checkbox {
  transform: scale(0.7);
  margin-right: 4rpx;
}

.link {
  color: #fff;
  font-weight: 500;
  text-decoration: underline;
}