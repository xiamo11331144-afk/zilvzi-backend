<!--pages/topic-detail/topic-detail.wxml-->
<view class="page-topic-detail">
  <view class="topic-card card">
    <view class="topic-card-header">
      <image class="avatar-sm" src="{{topic.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <text class="topic-card-nickname">{{topic.nickname}}</text>
      <text class="topic-card-time">{{topic.createTime}}</text>
    </view>
    <view class="topic-card-title">{{topic.title}}</view>
    <view class="topic-card-content" wx:if="{{topic.content}}">{{topic.content}}</view>
  </view>

  <view class="replies-section">
    <view class="replies-header">回复 ({{replies.length}})</view>
    <view class="reply-item" wx:for="{{replies}}" wx:key="id">
      <image class="avatar-sm" src="{{item.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="reply-content">
        <text class="reply-name">{{item.nickname}}</text>
        <text class="reply-text">{{item.content}}</text>
        <text class="reply-time">{{item.createTime}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{replies.length === 0}}">
      <text>暂无回复，快来参与讨论~</text>
    </view>
  </view>

  <view class="reply-bar">
    <input class="reply-input" placeholder="输入回复..." value="{{replyContent}}" bindinput="onReplyInput" confirm-type="send" bindconfirm="sendReply" />
    <button class="send-btn" bindtap="sendReply">发送</button>
  </view>
</view>
