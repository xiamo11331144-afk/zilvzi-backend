<!--pages/achievement/achievement.wxml-->
<view class="page-achievement">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
  <!-- 等级信息 -->
  <view class="level-card">
    <view class="level-header">
      <view class="level-badge">
        <text class="level-num">Lv.{{level}}</text>
      </view>
      <view class="level-info">
        <text class="level-title">{{levelTitle}}</text>
        <view class="exp-bar">
          <view class="exp-progress" style="width: {{expPercent}}%;"></view>
        </view>
      </view>
    </view>
    <view class="level-stats">
      <view class="stat">
        <text class="stat-num">{{stats.totalCheckins}}</text>
        <text class="stat-label">累计打卡</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.streakDays}}</text>
        <text class="stat-label">当前连续</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{stats.medals}}</text>
        <text class="stat-label">获得勋章</text>
      </view>
    </view>
  </view>

  <!-- 勋章墙 -->
  <view class="medals-section card">
    <view class="section-header">
      <text class="section-title">勋章墙</text>
      <text class="medal-count">{{medals.length}}/{{totalMedals}}</text>
    </view>
    <view class="medals-grid">
      <view class="medal-item {{item.unlocked ? '' : 'locked'}}" wx:for="{{allMedals}}" wx:key="key">
        <view class="medal-icon" style="background: {{item.color}};">
          <text>{{item.icon}}</text>
        </view>
        <text class="medal-name">{{item.name}}</text>
        <text class="medal-desc">{{item.condition}}</text>
        <text class="medal-date" wx:if="{{item.unlockTime}}">{{item.unlockTime}}</text>
      </view>
    </view>
  </view>

  <!-- 排行榜 -->
  <view class="ranking-card card">
    <view class="section-header">
      <text class="section-title">打卡排行榜</text>
      <text class="more">本周</text>
    </view>
    <view class="ranking-list">
      <view class="rank-item" wx:for="{{ranking}}" wx:key="id">
        <view class="rank-num {{item.rank <= 3 ? 'top' : ''}}">{{item.rank}}</view>
        <image class="avatar-sm" src="{{item.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="rank-info">
          <text class="rank-name">{{item.nickname}}</text>
          <text class="rank-level">打卡 {{item.totalDays || 0}} 天 · 连续 {{item.streakDays || 0}} 天</text>
        </view>
        <text class="rank-exp">Lv.{{item.level}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{ranking.length === 0}}">
      <text>暂无排行数据</text>
    </view>
  </view>
  </block>
</view>