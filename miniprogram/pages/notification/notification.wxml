<!--pages/notification/notification.wxml-->
<view class="page-notification">
  <!-- 顶部操作栏 -->
  <view class="action-bar" wx:if="{{notifications.length > 0}}">
    <text class="unread-count">{{unreadCount}}条未读</text>
    <view class="action-btns">
      <text class="action-btn" bindtap="clearAll">清除全部</text>
      <text class="mark-all" bindtap="markAllAsRead">全部已读</text>
    </view>
  </view>

  <!-- 通知列表 -->
  <view class="notification-list">
    <view class="notification-item {{item.isRead === 0 ? 'unread' : ''}}" 
          wx:for="{{notifications}}" wx:key="id"
          data-id="{{item.id}}" data-index="{{index}}">
      <view class="notification-avatar">
        <image class="avatar-sm" src="{{item.fromAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="type-icon">
          <text wx:if="{{item.type === 'partner_apply'}}">👋</text>
          <text wx:elif="{{item.type === 'partner_accept'}}">✅</text>
          <text wx:elif="{{item.type === 'checkin_remind'}}">⏰</text>
          <text wx:elif="{{item.type === 'partner_remove'}}">👋</text>
          <text wx:elif="{{item.type === 'private_message'}}">💬</text>
          <text wx:elif="{{item.type === 'comment'}}">💬</text>
          <text wx:elif="{{item.type === 'streak_break'}}">⚠️</text>
          <text wx:else>📢</text>
        </view>
      </view>
      <view class="notification-content" bindtap="readNotification" data-id="{{item.id}}" data-index="{{index}}">
        <view class="notification-header">
          <text class="notification-nickname">{{item.fromNickname || '系统'}}</text>
          <text class="notification-tag tag tag-primary">{{item.title}}</text>
        </view>
        <text class="notification-text">{{item.displayText}}</text>
        <text class="notification-time">{{item.createTime}}</text>
      </view>
      <view class="notification-actions">
        <view class="unread-dot" wx:if="{{item.isRead === 0}}"></view>
        <text class="delete-btn" bindtap="deleteOne" data-id="{{item.id}}" data-index="{{index}}">×</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{notifications.length === 0}}">
      <text class="empty-icon">🔔</text>
      <text class="empty-text">暂无通知</text>
    </view>
  </view>
</view>