<!-- 消息通知和圈子互动共用列表，但计数、已读和清理按当前分类处理。 -->
<view class="page-notification">
  <view class="category-tabs">
    <view class="category-tab {{category === 'notice' ? 'active' : ''}}" bindtap="selectCategory" data-category="notice">
      消息通知 <text class="unread-badge" wx:if="{{badgeCounts.notificationUnread > 0}}">{{badgeCounts.notificationUnread > 99 ? '99+' : badgeCounts.notificationUnread}}</text>
    </view>
    <view class="category-tab {{category === 'circle' ? 'active' : ''}}" bindtap="selectCategory" data-category="circle">
      圈子互动 <text class="unread-badge" wx:if="{{badgeCounts.circleUnread > 0}}">{{badgeCounts.circleUnread > 99 ? '99+' : badgeCounts.circleUnread}}</text>
    </view>
  </view>
  <view class="category-tip">{{category === 'circle' ? '这里查看评论、点赞和话题回复' : '这里查看打卡提醒、审核结果和搭子动态；私信请在“我的私信”查看'}}</view>
  <view class="badge-feedback" wx:if="{{badgeError}}" bindtap="retryBadges">未读数更新失败，点击重试</view>
  <view class="action-bar" wx:if="{{notifications.length > 0 || unreadCount > 0}}">
    <text class="unread-count">{{unreadCount}}条未读</text>
    <view class="action-btns">
      <text class="action-btn" bindtap="clearAll">清除本类</text>
      <text class="mark-all" bindtap="markAllAsRead">本类已读</text>
    </view>
  </view>

  <view class="notification-list">
    <view class="notification-item {{item.isRead === 0 ? 'unread' : ''}}" wx:for="{{notifications}}" wx:key="id">
      <view class="notification-avatar">
        <image class="avatar-sm" src="{{item.fromAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="type-icon">
          <text wx:if="{{item.type === 'comment' || item.type === 'topic_reply'}}">💬</text>
          <text wx:elif="{{item.type === 'like'}}">👍</text>
          <text wx:elif="{{item.type === 'partner_accept' || item.type === 'checkin_approved'}}">✅</text>
          <text wx:elif="{{item.type === 'checkin_remind'}}">⏰</text>
          <text wx:elif="{{item.type === 'streak_break' || item.type === 'checkin_rejected'}}">⚠️</text>
          <text wx:else>📢</text>
        </view>
      </view>
      <view class="notification-content" bindtap="readNotification" data-id="{{item.id}}">
        <view class="notification-header">
          <text class="notification-nickname">{{item.fromNickname || '系统'}}</text>
          <text class="notification-tag tag tag-primary">{{item.title}}</text>
        </view>
        <text class="notification-text">{{item.displayText}}</text>
        <text class="notification-time">{{item.createTime}}</text>
      </view>
      <view class="notification-actions">
        <view class="unread-dot" wx:if="{{item.isRead === 0}}"></view>
        <text class="delete-btn" bindtap="deleteOne" data-id="{{item.id}}">×</text>
      </view>
    </view>
    <view class="list-feedback" wx:if="{{loading}}">加载中...</view>
    <view class="list-feedback error" wx:elif="{{loadError}}" bindtap="retryLoad">{{loadError}}，点击重试</view>
    <view class="empty-state" wx:elif="{{notifications.length === 0}}">
      <text class="empty-icon">🔔</text><text class="empty-text">暂无{{category === 'circle' ? '圈子互动' : '消息通知'}}</text>
    </view>
    <view class="list-feedback" wx:elif="{{hasMore}}" bindtap="loadMore">点击加载更多</view>
    <view class="list-feedback" wx:else>已显示全部通知</view>
  </view>
</view>
