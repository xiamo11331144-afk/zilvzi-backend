server:
  port: 8081
  servlet:
    context-path: /

spring:
  application:
    name: zilvzi-backend

  # 数据源配置
  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/zilvzi?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
    username: root
    password: YOUR_MYSQL_PASSWORD
    druid:
      initial-size: 5
      max-active: 20
      min-idle: 5
      max-wait: 60000

  # Redis配置
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      timeout: 3000
      lettuce:
        pool:
          max-active: 20
          max-idle: 10
          min-idle: 5

  # 文件上传配置
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB
  banner:
    location:classpath:banner.txt

# MyBatis配置
mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.zilvzi.pojo
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

# PageHelper配置
pagehelper:
  helper-dialect: mysql
  reasonable: true
  support-methods-arguments: true

# JWT配置
jwt:
  secret: YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS_LONG
  expiration: 604800000

# 文件上传路径
upload:
  path: ./uploads/
  url: http://localhost:8081/uploads/

# AI配置 (DeepSeek)
ai:
  api:
    url: https://api.deepseek.com/chat/completions
    key: YOUR_DEEPSEEK_API_KEY
  model: deepseek-chat

# 微信小程序配置
wechat:
  appid: YOUR_WECHAT_APPID
  secret: YOUR_WECHAT_SECRET

# 阿里云OSS配置
aliyun:
  oss:
    endpoint: oss-cn-hangzhou.aliyuncs.com
    access-key-id: YOUR_ALIYUN_ACCESS_KEY_ID
    access-key-secret: YOUR_ALIYUN_ACCESS_KEY_SECRET
    bucket-name: YOUR_BUCKET_NAME
    url-prefix: https://YOUR_BUCKET_NAME.oss-cn-hangzhou.aliyuncs.com
  ocr:
    access-key-id: YOUR_ALIYUN_ACCESS_KEY_ID
    access-key-secret: YOUR_ALIYUN_ACCESS_KEY_SECRET

# 日志配置
logging:
  level:
    com.zilvzi.mapper: debug
    org.springframework: warn