<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zilvzi.mapper.CommentMapper">

    <resultMap id="commentMap" type="Comment">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="postId" column="post_id"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
    </resultMap>

    <select id="selectById" resultType="Comment">
        SELECT * FROM comment WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comment (user_id, post_id, content, create_time)
        VALUES (#{userId}, #{postId}, #{content}, NOW())
    </insert>

    <select id="selectByPostId" resultMap="commentMap">
        SELECT c.*, u.nickname, u.avatar
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.id
        WHERE c.post_id = #{postId}
        ORDER BY c.create_time ASC
    </select>

    <delete id="deleteById">
        DELETE FROM comment WHERE id = #{id}
    </delete>

    <select id="countByPostId" resultType="Integer">
        SELECT COUNT(*) FROM comment WHERE post_id = #{postId}
    </select>

    <select id="selectAll" resultMap="commentMap">
        SELECT c.*, u.nickname, u.avatar FROM comment c LEFT JOIN user u ON c.user_id = u.id
        <where>
            <if test="keyword != null and keyword != ''">
                c.content LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY c.create_time DESC LIMIT #{limit}
    </select>

    <delete id="deleteByPostId">
        DELETE FROM comment WHERE post_id = #{postId}
    </delete>
</mapper>