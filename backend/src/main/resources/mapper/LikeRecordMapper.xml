<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zilvzi.mapper.LikeRecordMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO like_record (user_id, post_id, create_time)
        VALUES (#{userId}, #{postId}, NOW())
    </insert>

    <select id="selectByUserAndPost" resultType="LikeRecord">
        SELECT * FROM like_record WHERE user_id = #{userId} AND post_id = #{postId}
    </select>

    <delete id="deleteById">
        DELETE FROM like_record WHERE id = #{id}
    </delete>

    <select id="countByPostId" resultType="Integer">
        SELECT COUNT(*) FROM like_record WHERE post_id = #{postId}
    </select>

    <delete id="deleteByPostId">
        DELETE FROM like_record WHERE post_id = #{postId}
    </delete>
</mapper>