<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zilvzi.mapper.VipMapper">
    <select id="selectVipUntil" resultType="java.time.LocalDateTime">
        SELECT vip_until FROM vip_membership WHERE user_id = #{userId}
    </select>
    <insert id="insertOrder" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vip_order(order_no,user_id,price_fen,duration_days,payment_channel,status,create_time)
        VALUES(#{orderNo},#{userId},#{priceFen},#{durationDays},#{paymentChannel},#{status},UTC_TIMESTAMP())
    </insert>
    <select id="selectOrder" resultType="com.zilvzi.pojo.VipOrder" useCache="false">
        SELECT id,order_no,user_id,price_fen,duration_days,payment_channel,status,create_time,confirmed_time
        FROM vip_order WHERE order_no=#{orderNo}
    </select>
    <update id="confirmOrder">
        UPDATE vip_order SET status='TEST_CONFIRMED',confirmed_time=UTC_TIMESTAMP()
        WHERE order_no=#{orderNo} AND status='PENDING'
    </update>
    <insert id="upsertVip">
        INSERT INTO vip_membership(user_id,vip_until) VALUES(#{userId},#{vipUntil})
        ON DUPLICATE KEY UPDATE vip_until=VALUES(vip_until)
    </insert>
</mapper>
