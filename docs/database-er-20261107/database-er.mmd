erDiagram
    direction TB
    achievement {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        varchar(50) medal_name "NOT NULL"
        varchar(20) medal_icon "NULL"
        varchar(20) medal_color "NULL"
        varchar(200) condition "NULL"
        datetime unlock_time "NULL"
    }
    ai_chat_history {
        bigint id PK "NOT NULL"
        bigint user_id "NOT NULL; LR"
        varchar(20) role "NOT NULL"
        text content "NOT NULL"
        varchar(20) session_type "NULL"
        datetime create_time "NULL"
    }
    checkin {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint goal_id FK "NOT NULL"
        bigint task_id "NULL; LR"
        varchar(500) content "NULL"
        varchar(255) image "NULL"
        datetime checkin_time "NULL"
        date date "NOT NULL"
        varchar(20) status "NULL"
        bigint partner_id "NULL; LR"
        varchar(500) proof_image "NULL"
        text proof_content "NULL"
        datetime review_time "NULL"
        varchar(200) review_comment "NULL"
    }
    circle {
        bigint id PK "NOT NULL"
        bigint creator_id FK "NOT NULL"
        varchar(100) name "NOT NULL"
        varchar(500) description "NULL"
        varchar(255) cover "NULL"
        varchar(255) tags "NULL"
        int member_count "NULL"
        int post_count "NULL"
        datetime create_time "NULL"
        datetime update_time "NULL"
    }
    circle_member {
        bigint id PK "NOT NULL"
        bigint circle_id FK "NOT NULL"
        bigint user_id FK "NOT NULL"
        int role "NULL"
        int status "NULL"
        datetime join_time "NULL"
    }
    comment {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint post_id FK "NOT NULL"
        varchar(500) content "NOT NULL"
        datetime create_time "NULL"
    }
    file_upload {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        varchar(255) file_name "NOT NULL"
        varchar(500) file_path "NOT NULL"
        varchar(50) file_type "NULL"
        bigint file_size "NULL"
        varchar(50) related_type "NULL"
        bigint related_id "NULL"
        text ai_parse_result "NULL"
        datetime create_time "NULL"
    }
    goal {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        varchar(100) name "NOT NULL"
        varchar(20) type "NOT NULL"
        varchar(500) description "NULL"
        date start_date "NULL"
        date end_date "NULL"
        varchar(20) status "NULL"
        int streak "NULL"
        int total_checkins "NULL"
        datetime create_time "NULL"
        datetime update_time "NULL"
    }
    like_record {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint post_id FK "NOT NULL"
        datetime create_time "NULL"
    }
    message {
        bigint id PK "NOT NULL"
        bigint from_user_id FK "NOT NULL"
        bigint to_user_id FK "NOT NULL"
        varchar(500) content "NOT NULL"
        varchar(20) type "NULL"
        bigint related_id "NULL"
        int is_read "NULL"
        datetime create_time "NULL"
    }
    notification {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint from_user_id "NULL; LR"
        varchar(50) type "NOT NULL"
        varchar(100) title "NULL"
        varchar(500) content "NULL"
        varchar(50) related_type "NULL"
        bigint related_id "NULL"
        int is_read "NULL"
        datetime create_time "NULL"
    }
    partner {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint partner_id FK "NOT NULL"
        bigint goal_id FK "NULL"
        varchar(10) match_mode "NOT NULL"
        varchar(20) status "NULL"
        varchar(20) prev_status "NULL"
        datetime create_time "NULL"
    }
    plan {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint goal_id FK "NULL"
        varchar(100) name "NULL"
        int total_days "NULL"
        int completed_days "NULL"
        text schedule_data "NULL"
        text remark "NULL"
        varchar(20) status "NULL"
        datetime create_time "NULL"
        datetime update_time "NULL"
        text outline "NULL"
        int current_phase "NULL"
    }
    plan_task {
        bigint id PK "NOT NULL"
        bigint plan_id FK "NOT NULL"
        int day_number "NOT NULL"
        date task_date "NULL"
        varchar(100) task_name "NULL"
        varchar(50) task_type "NULL"
        varchar(500) task_description "NULL"
        varchar(20) task_duration "NULL"
        varchar(20) task_icon "NULL"
        varchar(20) task_color "NULL"
        int sort_order "NULL"
        int completed "NULL"
        datetime create_time "NULL"
    }
    plan_template {
        bigint id PK "NOT NULL"
        varchar(50) goal_type "NOT NULL"
        varchar(100) goal_keyword "NOT NULL"
        int total_days "NOT NULL"
        varchar(20) difficulty "NULL"
        text plan_outline "NULL"
        text daily_tasks_template "NULL"
        varchar(50) ai_model "NULL"
        int usage_count "NULL"
        int success_count "NULL"
        float quality_score "NULL"
        datetime create_time "NULL"
        datetime update_time "NULL"
    }
    post {
        bigint id PK "NOT NULL"
        bigint user_id FK "NOT NULL"
        bigint circle_id FK "NULL"
        text content "NOT NULL"
        text images "NULL"
        int like_count "NULL"
        int comment_count "NULL"
        datetime create_time "NULL"
    }
    topic {
        bigint id PK "NOT NULL"
        bigint circle_id FK "NOT NULL"
        bigint user_id FK "NOT NULL"
        varchar(200) title "NOT NULL"
        text content "NULL"
        int is_pinned "NULL"
        int reply_count "NULL"
        datetime create_time "NULL"
    }
    topic_reply {
        bigint id PK "NOT NULL"
        bigint topic_id FK "NOT NULL"
        bigint user_id FK "NOT NULL"
        varchar(1000) content "NOT NULL"
        datetime create_time "NULL"
    }
    user {
        bigint id PK "NOT NULL"
        varchar(50) username UK "NULL"
        varchar(100) password "NULL"
        varchar(20) phone UK "NULL"
        varchar(100) email UK "NULL"
        varchar(50) nickname "NULL"
        varchar(255) avatar "NULL"
        varchar(500) bio "NULL"
        int level "NULL"
        int experience "NULL"
        int role "NULL"
        tinyint mentor_enabled "NOT NULL"
        varchar(100) openid UK "NULL"
        datetime create_time "NULL"
        datetime update_time "NULL"
        varchar(50) province "NULL"
        varchar(50) city "NULL"
        varchar(50) district "NULL"
    }
    vip_membership {
        bigint user_id PK, FK "NOT NULL"
        datetime vip_until "NULL"
    }
    vip_order {
        bigint id PK "NOT NULL"
        varchar(32) order_no UK "NOT NULL"
        bigint user_id FK "NOT NULL"
        int price_fen "NOT NULL"
        int duration_days "NOT NULL"
        varchar(32) payment_channel "NOT NULL"
        varchar(32) status "NOT NULL"
        datetime create_time "NOT NULL"
        datetime confirmed_time "NULL"
    }
    user ||--o{ achievement : "F01 FK user_id"
    user ||--o{ checkin : "F02 FK user_id"
    goal ||--o{ checkin : "F03 FK goal_id"
    user ||--o{ circle : "F04 FK creator_id"
    circle ||--o{ circle_member : "F05 FK circle_id"
    user ||--o{ circle_member : "F06 FK user_id"
    user ||--o{ comment : "F07 FK user_id"
    post ||--o{ comment : "F08 FK post_id"
    user ||--o{ file_upload : "F09 FK user_id"
    user ||--o{ goal : "F10 FK user_id"
    user ||--o{ like_record : "F11 FK user_id"
    post ||--o{ like_record : "F12 FK post_id"
    user ||--o{ message : "F13 FK from_user_id"
    user ||--o{ message : "F14 FK to_user_id"
    user ||--o{ notification : "F15 FK user_id"
    user ||--o{ partner : "F16 FK user_id"
    user ||--o{ partner : "F17 FK partner_id"
    goal |o--o{ partner : "F18 FK goal_id"
    user ||--o{ plan : "F19 FK user_id"
    goal |o--o{ plan : "F20 FK goal_id"
    plan ||--o{ plan_task : "F21 FK plan_id"
    user ||--o{ post : "F22 FK user_id"
    circle |o--o{ post : "F23 FK circle_id"
    circle ||--o{ topic : "F24 FK circle_id"
    user ||--o{ topic : "F25 FK user_id"
    topic ||--o{ topic_reply : "F26 FK topic_id"
    user ||--o{ topic_reply : "F27 FK user_id"
    user ||--o| vip_membership : "F28 FK user_id"
    user ||--o{ vip_order : "F29 FK user_id"
    user ||..o{ ai_chat_history : "L01 LR user_id"
    plan_task |o..o{ checkin : "L02 LR task_id"
    user |o..o{ checkin : "L03 LR partner_id"
    user |o..o{ notification : "L04 LR from_user_id"
